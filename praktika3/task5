# 1. список
shopping_list = ["хлеб", "молоко", "сыр", "яблоки"]

# 2. +
shopping_list.append("бананы")

# 3. вывод списка
print("список покупок:", shopping_list)

# 4. вывод множества
unique_items = set(shopping_list)
print("множество уникальных товаров:", unique_items)

# список - упорядоченная структура, которая сохраняет порядок добавления элементов и может содержать дубликаты
# множество - неупорядоченная структура, элементы в ней могут перемешаться, но она гарантирует уникальность (дубликаты автоматически удаляются)
